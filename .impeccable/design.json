  "narrative": {
    "northStar": "An experimental music publication",
    "overview": "Wide, heavy lettering and geometric signal art give this collection its own voice. Quiet paper supports legible project information; broad color fields give the expressive material room. The system is flat, direct, and playful without imitating the interfaces of the audio tools it presents.\n\nDense lists and spacious features share the same type, palette, and link language. The existing project sites retain independent identities; this system describes the personal hub, not a retroactive redesign of those products.",
    "keyCharacteristics": [
      "Wide display lettering paired with plain, readable body type.",
      "Lavender, green, and orange fields with crisp vector geometry.",
      "Flat surfaces, fine separators, and explicit text actions.",
      "Responsive reflow with visible keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Field Rule",
        "body": "Give expressive color a complete surface; keep the surrounding project information on paper.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Unbounded for the site identity and section hierarchy; use Archivo for project names, descriptions, metadata, and controls.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use color and spacing for separation; do not add shadows to these existing patterns.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use large color fields and precise vector geometry for expressive material.",
      "Do keep titles, descriptions, and destination links readable independently of artwork.",
      "Do preserve explicit keyboard focus and visible navigation at narrow widths.",
      "Do let layouts and action groups reflow instead of clipping content."
    ],
    "donts": [
      "Don't imply that abstract signal artwork is actual plugin output or interface imagery.",
      "Don't add shadows to the existing flat component patterns.",
      "Don't replace the self-hosted display face with a system font as the intended identity.",
      "Don't apply this hub's design to independently maintained project sites without a separate redesign brief."
    ]
  }
}
